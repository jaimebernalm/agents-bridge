{
  "hooks": {
    "SessionStart": [{
      "matcher": "^(startup|resume|clear|compact)$",
      "hooks": [{ "type": "command", "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run-bun.sh\" \"${CLAUDE_PLUGIN_ROOT}/dist/claude-hook.js\"", "timeout": 5 }]
    }],
    "UserPromptSubmit": [{
      "hooks": [{ "type": "command", "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run-bun.sh\" \"${CLAUDE_PLUGIN_ROOT}/dist/claude-hook.js\"", "timeout": 5 }]
    }],
    "Stop": [{
      "hooks": [{ "type": "command", "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run-bun.sh\" \"${CLAUDE_PLUGIN_ROOT}/dist/panel-hook.js\"", "timeout": 5 }]
    }],
    "SessionEnd": [{
      "hooks": [{ "type": "command", "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run-bun.sh\" \"${CLAUDE_PLUGIN_ROOT}/dist/claude-hook.js\"", "timeout": 5 }]
    }],
    "PostToolUse": [{
      "matcher": "^AskUserQuestion$",
      "hooks": [{ "type": "command", "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run-bun.sh\" \"${CLAUDE_PLUGIN_ROOT}/dist/answer-hook.js\"", "timeout": 5 }]
    }, {
      "matcher": "__(confirm_collaboration|apply_panel_action|send_message)$",
      "hooks": [{ "type": "command", "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run-bun.sh\" \"${CLAUDE_PLUGIN_ROOT}/dist/panel-hook.js\"", "timeout": 5 }]
    }]
  }
}
